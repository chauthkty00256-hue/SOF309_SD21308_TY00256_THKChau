<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="V-SPORT Automation Test Suite" verbose="1" parallel="false">

    <!-- Listener tự động chụp ảnh màn hình vào screenshots/ khi test fail -->
    <listeners>
        <listener class-name="com.poly.sof309.ui.listeners.ScreenshotTestListener"/>
    </listeners>

    <!-- Nhóm Smoke & Data-Driven cốt lõi (chạy mặc định với nhóm smoke và luồng CRUD phụ thuộc) -->
    <test name="V-SPORT Smoke and Data-Driven UI Suite">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>

        <classes>
            <class name="com.poly.sof309.ui.tests.AuthDataDrivenTestNGTest"/>
            <class name="com.poly.sof309.ui.tests.ManagerCrudFlowTestNGTest"/>
        </classes>
    </test>

</suite>
